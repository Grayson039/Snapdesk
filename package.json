{
  "name": "snapdesk",
  "productName": "Snapdesk",
  "version": "2.1.1",
  "description": "Free, offline screenshot capture and annotation",
  "main": "main.js",
  "author": "Will Grayson",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "xvfb-run -a node tests/app.test.js",
    "dist": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.willgrayson.snapdesk",
    "productName": "Snapdesk",
    "copyright": "Will Grayson",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "overlay-preload.js",
      "overlay.html",
      "editor.html",
      "assets/**",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "signAndEditExecutable": true,
      "artifactName": "Snapdesk-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Snapdesk",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    }
  }
}